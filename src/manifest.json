{
  "manifest_version": 3,
  "name": "X Clean Link",
  "version": "1.0",
  "description": "Strips tracking parameters from X/Twitter links on copy on X.com",
  "permissions": ["clipboardWrite"],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
